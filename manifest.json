{
  "name": "AutoNext Jut.su",
  "version": "1.0.1",
  "description": "It will automatically play next episode for you and skip intro",
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "manifest_version": 3,
  "author": "Den",
  "permissions": [
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "https://jut.su/*episode*"
  ],
  "action": {
    "default_popup": "index.html",
    "default_title": "AutoNext Jut.su",
    "default_icon": "icon48.png"
  },
  "content_scripts": [{
    "matches": ["https://jut.su/*episode*"],
    "js": ["content.js"],
    "run_at": "document_idle"
  }],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  }
}