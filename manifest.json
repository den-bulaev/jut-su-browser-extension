{
  "name": "AutoNext",
  "version": "1.0.0",
  "description": "This will click a skip btn for you",
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "manifest_version": 3,
  "author": "DenisBulaev",
  "permissions": [
    "cookies",
    "tabs",
    "activeTab",
    "scripting",
    "webNavigation"
  ],
  "host_permissions": [
    "https://jut.su/*"
  ],
  "action": {
    "default_popup": "index.html",
    "default_title": "AutoNext",
    "default_icon": "icon48.png"
  },
  "content_scripts": [{
    "matches": ["https://jut.su/*"],
    "js": ["script.js"],
    "run_at": "document_idle"
  }],
  "background": {
    "service_worker": "background.js"
  }
}